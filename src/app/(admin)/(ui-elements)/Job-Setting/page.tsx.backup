"use client"

import type React from "react"
import { useEffect, useState, useMemo, useCallback } from "react"
import Image from "next/image"
import { useRouter } from "next/navigation"
import { useForm } from "react-hook-form"
import Alert from "@/components/ui/alert/Alert"
import { ToastContainer } from "react-toastify"
import dynamic from "next/dynamic"
import "react-toastify/dist/ReactToastify.css"

import { API_CONFIG, buildApiUrl } from '@/config/api';

// Type Definitions
type OptionItem = {
  id: string
  name: string
  label?: string
  description?: string
}

type PriorityItem = {
  id: string
  parameter: string
  description: string
  value: string
}

type FitScoreSetting = {
  id: string
  category: "skill" | "experience" | "education"
  name: string
  weight: number
}

type FitCategory = "skill" | "experience" | "education"

type AlertState = {
  show: boolean
  variant: "success" | "error" | "warning" | "info"
  title: string
  message: string
}

type BrandingConfig = {
  company_name: string
  company_email: string
  company_website?: string
  email_subject_prefix: string
  email_signature: string
  primary_color: string
  secondary_color: string
}

const CustomizeInline = dynamic(() => import("./customize/page"), { ssr: false })

const JobSettings = () => {
  const router = useRouter()

  // State Management
  const [jobCategories, setJobCategories] = useState<OptionItem[]>([])
  const [experienceLevels, setExperienceLevels] = useState<OptionItem[]>([])
  const [jobTypes, setJobTypes] = useState<OptionItem[]>([])
  const [jobTypeInput, setJobTypeInput] = useState("")
  const [jobTypeError, setJobTypeError] = useState<string | null>(null)
  const [adminEmails, setAdminEmails] = useState<string[]>([])
  const [priorityItems, setPriorityItems] = useState<PriorityItem[]>([])
  const [fitScores, setFitScores] = useState<FitScoreSetting[]>([])
  const [openDropdowns, setOpenDropdowns] = useState<{ [key: string]: boolean }>({})
  const [loading, setLoading] = useState(true)
  const [backendConnected, setBackendConnected] = useState<boolean | null>(null) // null = unknown, true = connected, false = disconnected
  const [alert, setAlert] = useState<AlertState>({
    show: false,
    variant: "info",
    title: "",
    message: "",
  })

  // Form Configuration State
  const [formConfig, setFormConfig] = useState<JobApplicationFormConfig | null>(null)

  // Applicant Message State
  const [applicantMessage, setApplicantMessage] = useState("")
  const [draftApplicantMessage, setDraftApplicantMessage] = useState("")
  const [applicantMsgPlaceholders, setApplicantMsgPlaceholders] = useState<string[]>([
    "{name}",
    "{applicant_id}",
    "{job_category}",
  ])
  const [isCustomApplicantMsg, setIsCustomApplicantMsg] = useState<boolean>(false)
  const [isEditingApplicantMsg, setIsEditingApplicantMsg] = useState(false)

  // Priority Settings State
  const [selectedPriorityCategory, setSelectedPriorityCategory] = useState<string | null>(null)
  const [priority, setPriority] = useState<number | "">("")
  const [priorityError, setPriorityError] = useState<string | null>(null)
  const [priorityCategoryError, setPriorityCategoryError] = useState<string | null>(null)

  // Fit Score Settings State
  const [newFitCategory, setNewFitCategory] = useState<"skill" | "experience" | "education" | "Select Category">(
    "Select Category",
  )
  const [newFitName, setNewFitName] = useState("")
  const [newFitWeight, setNewFitWeight] = useState<number | "">(20)
  const [editingFitScore, setEditingFitScore] = useState<FitScoreSetting | null>(null)
  const [isEditing, setIsEditing] = useState(false)
  const [fitError, setFitError] = useState<string | null>(null)
  const [fitCategoryError, setFitCategoryError] = useState<string | null>(null)

  // Logo Management State
  const [currentLogoUrl, setCurrentLogoUrl] = useState<string | null>(null)
  const [logoUploading, setLogoUploading] = useState(false)
  const [showDeleteLogoModal, setShowDeleteLogoModal] = useState(false)

  // Email Branding State
  const [branding, setBranding] = useState<BrandingConfig>({
    company_name: "",
    company_email: "",
    company_website: "",
    email_subject_prefix: "",
    email_signature: "",
    primary_color: "#2c3e50",
    secondary_color: "#3498db",
  })
  const [brandingLoading, setBrandingLoading] = useState(false)

  // Toggle between Settings and Customize inline view
  const [activeTab, setActiveTab] = useState<"settings" | "customize">("settings")

  // Helper: placeholder by category for Fit Score Name
  const getFitPlaceholder = (
    category: "skill" | "experience" | "education" | "Select Category",
  ): string => {
    switch (category) {
      case "skill":
        return "e.g., React, Excellent Communication, Python"
      case "experience":
        return "e.g., Entry Level, Senior Level, 4 months"
      case "education":
        return "e.g., BTech, BBA, Masters"
      default:
        return "e.g., React, Senior Level, BTech"
    }
  }

  // Computed Values
  const isApplicantMsgValid = useMemo(() => (draftApplicantMessage || "").trim().length >= 30, [draftApplicantMessage])

  const selectedPriorityLabel = useMemo(() => {
    if (!selectedPriorityCategory) return "Select Category"
    const [type, id] = selectedPriorityCategory.split("-")
    if (type === "cat") {
      const cat = jobCategories.find((c) => String(c.id) === id)
      return cat ? cat.name : "Select Category"
    } else if (type === "exp") {
      const exp = experienceLevels.find((e) => String(e.id) === id)
      return exp ? exp.name : "Select Category"
    }
    return "Select Category"
  }, [selectedPriorityCategory, jobCategories, experienceLevels])

  // Utility Functions
  const showAlert = (variant: "success" | "error" | "warning" | "info", title: string, message: string) => {
    setAlert({ show: true, variant, title, message })
    setTimeout(() => setAlert({ show: false, variant: "info", title: "", message: "" }), 5000)
  }

  const normalizeExperienceName = (raw: string): string => {
    const base = (raw || "").toLowerCase().trim().replace(/\s+/g, " ")
    return base
      .split(" ")
      .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : w))
      .join(" ")
  }

  const normalizeFitName = (category: FitCategory, raw: string): { key: string; canonicalName: string } => {
    const base = (raw || "").toLowerCase().replace(/\./g, "").replace(/_/g, " ").replace(/\s+/g, " ").trim()
    const canonical = base
      .split(" ")
      .map((w) => (w ? w.charAt(0).toUpperCase() + w.slice(1) : w))
      .join(" ")
    return { key: canonical.toLowerCase().replace(/\s+/g, "_"), canonicalName: canonical }
  }

  const isValidExperienceForAdd = (value: string): boolean => {
    if (!value) return false
    const trimmed = value.trim()
    if (/^\d+$/.test(trimmed)) {
      const years = Number.parseInt(trimmed, 10)
      return years >= 0 && years <= 75
    }
    return trimmed.length >= 0 && trimmed.length <= 20
  }

  const isValidExperience = useCallback((value: string): boolean => {
    if (!value) return false
    const trimmed = value.trim()
    const numericMatch = /^\d+$/.test(trimmed)
    if (numericMatch) {
      const years = Number.parseInt(trimmed, 10)
      return years >= 0 && years <= 75
    }
    const lower = trimmed.toLowerCase()
    return experienceLevels.some((lvl) => lvl.name.toLowerCase() === lower)
  }, [experienceLevels])


  // Fetch applicant message
  const fetchApplicantMessage = async () => {
    try {
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_APPLICANT_MESSAGE))
      if (!res.ok) return
      const data = await res.json()
      setApplicantMessage(data.message || "")
      setDraftApplicantMessage(data.message || "")
      if (Array.isArray(data.placeholders)) setApplicantMsgPlaceholders(data.placeholders)
      setIsCustomApplicantMsg(Boolean(data.is_custom))
    } catch {
      console.error("Failed to fetch applicant message")
    }
  }

  // Fetch priorities
  const fetchPriorities = async () => {
    try {
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_PRIORITIES))
      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}))
        console.error("GET priorities failed:", res.status, errorData)
        console.error("Failed to fetch priorities: " + (errorData.detail || res.statusText))
        return
      }
      const data = await res.json()
      console.log("GET priorities response:", data)
      if (Array.isArray(data)) {
        setPriorityItems(data)
      } else if (Array.isArray(data.data)) {
        setPriorityItems(data.data)
      } else {
        setPriorityItems([])
        console.error("GET priorities response not an array: " + JSON.stringify(data))
      }
    } catch (e) {
      console.error("Error fetching priorities", e)
      setPriorityItems([])
    }
  }

  // Fetch fit scores
  const fetchFitScores = async (category?: "skill" | "experience" | "education", showNotifications = false) => {
    try {
      const url = category
        ? `${API_CONFIG.ENDPOINTS.JOBS_FIT_SCORES}?category=${category}`
        : API_CONFIG.ENDPOINTS.JOBS_FIT_SCORES
      const res = await fetch(url)
      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}))
        if (showNotifications) {
          console.error(errorData.detail || "Failed to fetch fit score settings")
        }
        return
      }
      const data = await res.json()
      setFitScores(Array.isArray(data) ? data : [])
      if (showNotifications) {
        const count = Array.isArray(data) ? data.length : 0
        console.info(`Fit score settings fetched${category ? ` for ${category}` : ""}: ${count}`)
      }
    } catch (e) {
      console.error("Failed to fetch fit scores", e)
      if (showNotifications) {
        console.error("Network error: Failed to fetch fit score settings")
      }
    }
  }

  // Fetch job application form configuration
  const fetchFormConfig = async () => {
    try {
      // Fetch form configuration and actual database data in parallel
      const [formRes, categoriesRes, experiencesRes, jobTypesRes] = await Promise.all([
        fetch(buildApiUrl('/customize/admin/customize-job-application-form?widget_id=Model'), {
          method: "GET",
          headers: { "Content-Type": "application/json" }
        }),
        fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_CATEGORIES)),
        fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_EXPERIENCES)),
        fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_JOB_TYPES))
      ])

      if (!formRes.ok) {
        console.error("Failed to fetch form configuration:", formRes.status)
        return
      }

      const formData = await formRes.json()
      console.log("Fetched form configuration:", formData)
      setFormConfig(formData)

      // Fetch actual database categories, experiences and job types
      let dbCategories: OptionItem[] = []
      let dbExperiences: OptionItem[] = []
      let dbJobTypes: OptionItem[] = []

      if (categoriesRes.ok) {
        dbCategories = await categoriesRes.json()
        console.log("Fetched database categories:", dbCategories)
      }

      if (experiencesRes.ok) {
        dbExperiences = await experiencesRes.json()
        console.log("Fetched database experiences:", dbExperiences)
      }
      if (jobTypesRes.ok) {
        dbJobTypes = await jobTypesRes.json()
        console.log("Fetched database job types:", dbJobTypes)
      }

      // Update local state with actual database data
      setJobCategories(dbCategories)
      setExperienceLevels(dbExperiences)
      setJobTypes(dbJobTypes)

    } catch (error) {
      console.error("Error fetching form configuration:", error)
    }
  }

  const handleAddJobType = async () => {
    try {
      const value = (jobTypeInput || "").trim()
      if (!value) {
        setJobTypeError("Job type cannot be blank")
        showAlert("error", "Validation", "Job type cannot be blank.")
        return
      }
      if (value.length < 3 || value.length > 30) {
        setJobTypeError("Job type must be 3–30 characters")
        showAlert("error", "Validation", "Job type must be 3–30 characters.")
        return
      }
      const exists = jobTypes.some((t) => t.name.toLowerCase() === value.toLowerCase())
      if (exists) {
        setJobTypeError(`Job type "${value}" already exists`)
        showAlert("error", "Duplicate", `Job type "${value}" already exists.`)
        return
      }
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_JOB_TYPES), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: value })
      })
      if (!res.ok) {
        const err = await res.json().catch(() => ({}))
        console.error("Failed to add job type:", err.detail || res.statusText)
        setJobTypeError("Failed to add job type")
        showAlert("error", "Failed", "Could not add job type.")
        return
      }
      setJobTypeInput("")
      setJobTypeError(null)
      showAlert("success", "Added", `Job type "${value}" added.`)
      await fetchFormConfig()
    } catch (e) {
      console.error("Add job type error", e)
      setJobTypeError("Failed to add job type")
      showAlert("error", "Failed", "Could not add job type.")
    }
  }

  const handleDeleteJobType = async (id: string) => {
    try {
      const res = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_JOB_TYPES}/${id}`), { method: "DELETE" })
      if (!res.ok) {
        const err = await res.json().catch(() => ({}))
        console.error("Failed to delete job type:", err.detail || res.statusText)
        return
      }
      showAlert("success", "Removed", "Job type deleted.")
      await fetchFormConfig()
    } catch (e) {
      console.error("Delete job type error", e)
    }
  }

  // Add fit score function
  const addFitScore = async () => {
    if (newFitCategory === "Select Category") {
      console.warn("Please select a category (Skill, Experience, or Education)")
      setFitCategoryError("Please select a category")
      showAlert("error", "Validation", "Select a category.")
      return
    }
    if (!newFitName.trim()) {
      console.warn("Fit score name cannot be blank")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Fit score name cannot be blank.")
      return
    }
    if (newFitName.trim().length < 1 || newFitName.trim().length > 50) {
      console.warn("Fit score name must be between 1 and 50 characters")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Name must be 1–50 characters.")
      return
    }
    if (newFitWeight === "" || Number.isNaN(Number(newFitWeight))) {
      console.warn("Please enter a weight between 1 and 100")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Enter a weight between 1 and 100.")
      return
    }
    if (Number(newFitWeight) < 1 || Number(newFitWeight) > 100) {
      console.warn("Weight must be between 1 and 100")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Weight must be 1-100.")
      return
    }

    const nameToAdd = newFitName.trim()
    const categoryToAdd = newFitCategory
    const weightToAdd = Number(newFitWeight)

    const existsLocal = fitScores.some(
      (s) => s.category === categoryToAdd && s.name.toLowerCase() === nameToAdd.toLowerCase(),
    )
    if (existsLocal) {
      console.warn(`Setting already exists for this category: ${categoryToAdd} - ${nameToAdd}`)
      showAlert("error", "Duplicate", `"${nameToAdd}" already exists for ${categoryToAdd}.`)
      return
    }

    try {
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_FIT_SCORES), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          category: categoryToAdd,
          name: nameToAdd,
          weight: weightToAdd,
        }),
      })

      const data = await res.json().catch(() => ({}))
      if (!res.ok) {
        const detail = (data && (data.detail || data.message)) || "Failed to add fit score setting"
        if (/exist/i.test(String(detail))) {
          console.warn(detail)
          showAlert("error", "Duplicate", `"${nameToAdd}" already exists for ${categoryToAdd}.`)
          return
        }
        console.error(detail)
        showAlert("error", "Failed", typeof detail === "string" ? detail : "Could not add fit score setting.")
        return
      }

      const newItem = {
        id: data.id || Date.now().toString(),
        category: categoryToAdd,
        name: nameToAdd,
        weight: weightToAdd,
      }
      setFitScores((prev) => [...prev, newItem])

      setNewFitName("")
      setNewFitWeight(20)
      setNewFitCategory("Select Category")
      setFitError(null)
      setFitCategoryError(null)

      console.info(`Fit score setting "${nameToAdd}" added successfully!`)
      showAlert("success", "Added", `Fit score setting "${nameToAdd}" added.`)
    } catch {
      console.error("Network error: Failed to add fit score setting")
      showAlert("error", "Failed", "Could not add fit score setting.")
    }
  }

  // Delete fit score function
  const deleteFitScore = async (id: string) => {
    try {
      const res = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_FIT_SCORES}/${id}`), {
        method: "DELETE",
      })
      if (!res.ok) {
        const err = await res.json().catch(() => ({}))
        console.error(err.detail || "Failed to delete fit score setting")
        showAlert("error", "Failed", "Could not delete fit score setting.")
        return
      }
      setFitScores((prev) => prev.filter((item) => item.id !== id))
      console.warn("Fit score setting deleted successfully!")
      showAlert("success", "Deleted", "Fit score setting removed.")
    } catch {
      console.error("Network error: Failed to delete fit score setting")
      showAlert("error", "Failed", "Could not delete fit score setting.")
    }
  }

  // Start editing function
  const startEditing = (item: FitScoreSetting) => {
    setEditingFitScore(item)
    setNewFitCategory(item.category)
    setNewFitName(item.name)
    setNewFitWeight(item.weight)
    setIsEditing(true)
  }

  // Cancel editing function
  const cancelEditing = () => {
    setEditingFitScore(null)
    setNewFitCategory("Select Category")
    setNewFitName("")
    setNewFitWeight(20)
    setIsEditing(false)
    setFitError(null)
  }

  // Handle update fit score function
  const handleUpdateFitScore = async () => {
    if (!editingFitScore) return
    if (newFitCategory === "Select Category") {
      console.error("Please select a category (Skill, Experience, or Education)")
      // Only show category-level inline error
      showAlert("error", "Validation", "Select a category.")
      setFitCategoryError("Please select a category")
      return
    }
    if (!newFitName.trim()) {
      console.error("Fit score name cannot be blank")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Fit score name cannot be blank.")
      return
    }
    if (newFitName.trim().length < 1 || newFitName.trim().length > 50) {
      console.error("Fit score name must be between 1 and 50 characters")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Name must be 1–50 characters.")
      return
    }
    if (newFitWeight === "" || Number.isNaN(Number(newFitWeight))) {
      console.error("Please enter a weight between 1 and 100")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Enter a weight between 1 and 100.")
      return
    }
    if (Number(newFitWeight) < 1 || Number(newFitWeight) > 100) {
      console.error("Weight must be between 1 and 100")
      setFitCategoryError(null)
      showAlert("error", "Validation", "Weight must be 1-100.")
      return
    }

    try {
      const res = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_FIT_SCORES}/${editingFitScore.id}`), {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          category: newFitCategory,
          name: newFitName.trim(),
          weight: Number(newFitWeight),
        }),
      })

      if (!res.ok) {
        const data = await res.json().catch(() => ({}))
        console.error(data.detail || "Failed to update fit score setting")
        showAlert("error", "Failed", "Could not update fit score setting.")
        return
      }

      setFitScores((prev) =>
        prev.map((item) =>
          item.id === editingFitScore.id
            ? { ...item, category: newFitCategory, name: newFitName.trim(), weight: Number(newFitWeight) }
            : item,
        ),
      )

      cancelEditing()
      setFitError(null)
      console.info(`Fit score setting "${newFitName.trim()}" updated successfully!`)
      showAlert("success", "Updated", `Fit score setting "${newFitName.trim()}" updated.`)
    } catch {
      console.error("Network error: Failed to update fit score setting")
      showAlert("error", "Failed", "Could not update fit score setting.")
    }
  }

  // Check if backend is available
  const checkBackendHealth = async () => {
    try {
      const res = await fetch(buildApiUrl('/health'), {
        method: 'GET',
        signal: AbortSignal.timeout(5000) // 5 second timeout
      })
      return res.ok
    } catch {
      return false
    }
  }

  // Logo functions
  const fetchLogo = async () => {
    try {
      const timestamp = new Date().getTime()
      const res = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_LOGO}?t=${timestamp}`), {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
        },
        // Add timeout to prevent hanging requests
        signal: AbortSignal.timeout(10000) // 10 second timeout
      })
      
      if (!res.ok) {
        // Handle different error status codes
        if (res.status === 404) {
          console.log("No logo found - this is normal for new setups")
          setCurrentLogoUrl(null)
          return
        }
        
        if (res.status === 500) {
          console.warn("Server error when fetching logo - backend may not be running or endpoint not implemented")
          setCurrentLogoUrl(null)
          return
        }
        
        const errorData = await res.json().catch(() => ({}))
        console.error("Failed to fetch logo:", res.status, errorData)
        setCurrentLogoUrl(null)
        return
      }
      
      const data = await res.json()
      console.log("Logo fetched successfully:", data.logo_url)
      setCurrentLogoUrl(data.logo_url || null)
    } catch (e) {
      // Handle different types of errors
      if (e instanceof Error) {
        if (e.name === 'AbortError') {
          console.warn("Logo fetch timed out - server may be slow or unreachable")
        } else if (e.message.includes('fetch')) {
          console.warn("Network error when fetching logo - backend may not be running")
        } else {
          console.error("Error fetching logo:", e.message)
        }
      } else {
        console.error("Unknown error fetching logo:", e)
      }
      setCurrentLogoUrl(null)
    }
  }

  const handleLogoUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0]
    if (!file) return

    // Validate size (<= 5MB)
    const MAX_BYTES = 5 * 1024 * 1024
    if (file.size > MAX_BYTES) {
      showAlert("error", "Invalid Logo", "Maximum size is 5MB.")
      event.target.value = ""
      return
    }

    // Validate format (PNG, JPG, JPEG, GIF)
    const allowedTypes = ["image/png", "image/jpeg", "image/jpg", "image/gif"]
    const ext = (file.name.split(".").pop() || "").toLowerCase()
    const allowedExts = ["png", "jpg", "jpeg", "gif"]
    if (!allowedTypes.includes(file.type) || !allowedExts.includes(ext)) {
      showAlert("error", "Invalid Logo", "Allowed formats: PNG, JPG, JPEG, GIF.")
      event.target.value = ""
      return
    }

    // Validate dimensions (300x100)
    const objectUrl = URL.createObjectURL(file)
    try {
      const img = new window.Image()
      const dimensionOk: boolean = await new Promise((resolve) => {
        img.onload = () => {
          const ok = img.width === 300 && img.height === 100
          resolve(ok)
        }
        img.onerror = () => resolve(false)
        img.src = objectUrl
      })
      if (!dimensionOk) {
        showAlert("error", "Invalid Logo", "Size must be exactly 300x100px.")
        URL.revokeObjectURL(objectUrl)
        event.target.value = ""
        return
      }
    } catch {
      URL.revokeObjectURL(objectUrl)
      showAlert("error", "Invalid Logo", "Could not read image dimensions.")
      event.target.value = ""
      return
    } finally {
      URL.revokeObjectURL(objectUrl)
    }

    const formData = new FormData()
    formData.append("file", file)

    setLogoUploading(true)

    try {
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_UPLOAD_LOGO), {
        method: "POST",
        body: formData,
      })

      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}))
        console.error(errorData.detail || "Failed to upload logo.")
        showAlert("error", "Failed", errorData.detail || "Could not upload logo.")
        return
      }

      console.info("Logo uploaded successfully!")
      showAlert("success", "Uploaded", "Logo uploaded successfully.")

      setTimeout(async () => {
        await fetchLogo()
      }, 500)
    } catch {
      console.error("Network error: Failed to upload logo.")
      showAlert("error", "Failed", "Network error: Could not upload logo.")
    } finally {
      setLogoUploading(false)
      event.target.value = ""
    }
  }

  const handleDeleteLogo = async () => {
    if (!currentLogoUrl) return
      try {
        const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_LOGO), {
          method: "DELETE",
        })

        if (!res.ok) {
          const errorData = await res.json().catch(() => ({}))
          console.error(errorData.detail || "Failed to delete logo.")
          showAlert("error", "Failed", errorData.detail || "Could not delete logo.")
          return
        }

        console.info("Logo removed successfully!")
        showAlert("success", "Removed", "Logo removed successfully.")
        setCurrentLogoUrl(null)
        setShowDeleteLogoModal(false)
      } catch (e) {
        console.error("Error deleting logo:", e)
        console.error("Network error: Failed to delete logo.")
        showAlert("error", "Failed", "Network error: Could not delete logo.")
        setShowDeleteLogoModal(false)
    }
  }

  // useEffect for initial data loading
  useEffect(() => {
    let cancelled = false
    setLoading(true)
    const fetchAll = async () => {
      try {
        // First check if backend is available
        const isBackendHealthy = await checkBackendHealth()
        setBackendConnected(isBackendHealthy)
        
        if (!isBackendHealthy) {
          console.warn('Backend is not available - some features may not work properly')
          if (!cancelled) setLoading(false)
          return
        }
        
        // Use Promise.allSettled to handle individual failures gracefully
        const results = await Promise.allSettled([
        fetchFormConfig(), // Fetch form configuration first to get categories and experiences
        fetchAdminEmails(),
        fetchEmailBranding(),
        fetchApplicantMessage(),
        fetchPriorities(),
        fetchFitScores(),
        fetchLogo(),
      ])
        
        // Log any failures for debugging
        results.forEach((result, index) => {
          if (result.status === 'rejected') {
            const functionNames = ['fetchFormConfig', 'fetchAdminEmails', 'fetchEmailBranding', 'fetchApplicantMessage', 'fetchPriorities', 'fetchFitScores', 'fetchLogo']
            console.warn(`Failed to fetch ${functionNames[index]}:`, result.reason)
          }
        })
        
      if (!cancelled) setLoading(false)
        
        // Retry admin emails after delays (these seem to be retried for a reason)
      setTimeout(() => {
          if (!cancelled) fetchAdminEmails().catch(e => console.warn('Retry fetchAdminEmails failed:', e))
      }, 300)
      setTimeout(() => {
          if (!cancelled) fetchAdminEmails().catch(e => console.warn('Second retry fetchAdminEmails failed:', e))
      }, 1200)
      } catch (error) {
        console.error('Unexpected error in fetchAll:', error)
        setBackendConnected(false)
        if (!cancelled) setLoading(false)
      }
    }
    fetchAll()
    return () => {
      cancelled = true
    }
  }, [])

  const [showHelp, setShowHelp] = useState(false)

  // React Hook Form for Job Category
  const {
    register: registerCategory,
    handleSubmit: handleSubmitCategory,
    formState: { errors: categoryErrors },
    reset: resetCategory,
    setValue: setCategoryValue,
  } = useForm<{ jobCategory: string }>({
    mode: "onSubmit",
    defaultValues: { jobCategory: "" },
  })

  // React Hook Form for Experience with enhanced validation
  const {
    register: registerExperience,
    handleSubmit: handleSubmitExperience,
    formState: { errors: experienceErrors },
    reset: resetExperience,
    watch: watchExperience,
    setValue: setExperienceValue,
  } = useForm<{ experience: string }>({
    mode: "onSubmit",
    defaultValues: { experience: "" },
  })

  const {
    register: registerEmail,
    handleSubmit: handleSubmitEmail,
    formState: { errors: emailFormErrors },
    reset: resetEmail,
    setValue: setEmailValue,
  } = useForm<{ notificationEmail: string }>({
    mode: "onSubmit",
    defaultValues: { notificationEmail: "" },
  })

  // Watch experience field for real-time validation
  const watchedExperience = watchExperience("experience")

  // Real-time experience validation with notifications
  useEffect(() => {
    if (watchedExperience) {
      const timeoutId = setTimeout(() => {
        if (isValidExperience(watchedExperience)) {
          // const description = getExperienceDescription(watchedExperience);
          // addNotification(`Valid experience level: ${description}`, 'success', 3000);
        } else {
          // addNotification('Invalid experience level. Use 0-50 years or predefined levels like "Fresher", "Junior", "Senior", etc.', 'error', 4000);
        }
      }, 500)
      return () => clearTimeout(timeoutId)
    }
  }, [watchedExperience, isValidExperience])

  // Note: fetchCategories and fetchExperiences are now handled by fetchFormConfig
  // which gets the current form configuration and updates the local state accordingly

  const fetchAdminEmails = async () => {
    try {
      const ts = Date.now()
      const res = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_NOTIFICATION_EMAILS}?t=${ts}`), {
        cache: "no-store" as RequestCache,
      })
      const data = await res.json()
      const emails: string[] = Array.isArray(data?.emails)
        ? (data.emails as unknown[])
          .filter((val: unknown): val is string => typeof val === "string")
          .map((email) => email.trim().toLowerCase())
        : []
      setAdminEmails(emails)
    } catch {
      // addNotification('Failed to load admin emails', 'error');
    }
  }

  // Email Branding APIs
  const fetchEmailBranding = async () => {
    try {
      setBrandingLoading(true)
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_EMAIL_BRANDING))
      const data = await res.json().catch(() => ({}))
      if (res.ok && data && data.success && data.config) {
        setBranding((prev) => ({ ...prev, ...data.config }))
      }
    } catch {
    } finally {
      setBrandingLoading(false)
    }
  }

  const saveEmailBranding = async (): Promise<boolean> => {
    try {
      // Only require company name, company email, and signature (prefix is not used)
      if (!branding.company_name.trim() || !branding.company_email.trim() || !branding.email_signature.trim()) {
        showAlert("error", "Validation", "Fill required branding fields.")
        return false
      }
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_EMAIL_BRANDING), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(branding),
      })
      const data = await res.json().catch(() => ({}))
      if (!res.ok) {
        const detail = data?.detail || data?.message || "Failed to save branding"
        showAlert("error", "Failed", String(detail))
        return false
      }
      showAlert("success", "Saved", "Email branding updated.")
      return true
    } catch {
      showAlert("error", "Failed", "Could not save branding.")
      return false
    }
  }

  const resetEmailBranding = async () => {
    try {
      const res = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_EMAIL_BRANDING}/reset`))
      const data = await res.json().catch(() => ({}))
      if (res.ok && data?.config) {
        setBranding((prev) => ({ ...prev, ...data.config }))
        showAlert("success", "Reset", "Branding reset to defaults.")
      } else {
        showAlert("error", "Failed", "Could not reset branding.")
      }
    } catch {
      showAlert("error", "Failed", "Network error while resetting branding.")
    }
  }

  const deleteAdminEmail = async (email: string) => {
    try {
      const res = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_NOTIFICATION_EMAILS}/${encodeURIComponent(email)}`), {
        method: "DELETE",
      })
      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}))
        console.error("Failed to delete admin email: " + (errorData.detail || res.statusText))
        return
      }
      await fetchAdminEmails()
      showAlert("success", "Deleted", "Admin email removed successfully.")
      setTimeout(fetchAdminEmails, 250)
    } catch {
      console.error("Failed to delete admin email")
      showAlert("error", "Failed", "Could not delete admin email.")
    }
  }

  const updateApplicantMessage = async () => {
    try {
      const payload = {
        message: (draftApplicantMessage || "").trim(),
      }
      if (!payload.message || payload.message.length < 30) {
        console.warn("Applicant message must be at least 30 characters.")
        showAlert("error", "Validation", "Message must be at least 30 characters.")
        return
      }
      await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_APPLICANT_MESSAGE), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
      console.info("Applicant message updated!")
      showAlert("success", "Updated", "Applicant message saved.")
      setIsCustomApplicantMsg(true)
    } catch {
      // addNotification('Failed to update applicant message', 'error');
    }
  }

  // Reset applicant message to default (calls DELETE endpoint)
  const resetApplicantMessage = async () => {
    try {
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_APPLICANT_MESSAGE), {
        method: "DELETE",
      })
      if (!res.ok) {
        const err = await res.json().catch(() => ({}))
        console.error("Failed to reset applicant message", err)
        showAlert("error", "Failed", "Could not reset to default.")
        return
      }
      await fetchApplicantMessage()
      showAlert("success", "Reset", "Applicant message reset to default.")
      setIsEditingApplicantMsg(false)
      setIsCustomApplicantMsg(false)
    } catch (e) {
      console.error("Network error: reset applicant message", e)
      showAlert("error", "Failed", "Network error while resetting message.")
    }
  }

  // Enhanced category validation
  // Type definitions for the job application form
  interface FieldBase {
    label: string;
    required: boolean;
  }

  interface TextFieldConfig extends FieldBase {
    placeholder: string;
  }

  interface SelectFieldConfig extends FieldBase {
    options: string[];
  }

  interface ResumeFieldConfig extends FieldBase {
    maxSize: number;
    disabled: boolean;
  }

  interface JobApplicationFormConfig {
    widget_id: string;
    title: string;
    fields: {
      name: TextFieldConfig;
      email: TextFieldConfig;
      phone: TextFieldConfig;
      category: SelectFieldConfig;
      experience: SelectFieldConfig;
      resume: ResumeFieldConfig;
    };
    submitButtonText: string;
    successMessage: string;
  }

  interface ApiResponse {
    message: string;
  }

  interface ErrorResponse {
    detail?: string;
  }



  const onAddCategory = async (data: { jobCategory: string }): Promise<void> => {
    try {
      if (!data.jobCategory.trim()) {
        console.warn("Category name cannot be blank")
        showAlert("error", "Validation", "Category name cannot be blank.")
        return
      }
      if (data.jobCategory.length < 2) {
        console.warn("Category name must be at least 2 characters long")
        showAlert("error", "Validation", "Category name must be at least 2 characters.")
        return
      }
      if (data.jobCategory.length > 50) {
        console.warn("Category name must be less than 50 characters")
        showAlert("error", "Validation", "Category name must be under 50 characters.")
        return
      }

      const trimmedCategory: string = data.jobCategory.trim()
      const existingCategory: OptionItem | undefined = jobCategories.find(
        (cat: OptionItem) => cat.name.toLowerCase() === trimmedCategory.toLowerCase()
      )
      if (existingCategory) {
        console.warn(`Job category "${trimmedCategory}" already exists!`)
        showAlert("error", "Duplicate", `Job category "${trimmedCategory}" already exists.`)
        return
      }

      // Step 1: Add category to the jobs/categories endpoint
      const categoryRes: Response = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_CATEGORIES), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: trimmedCategory }),
      })

      if (!categoryRes.ok) {
        const categoryErrorData: ErrorResponse = await categoryRes.json().catch(() => ({}))
        console.error("Failed to add job category: " + (categoryErrorData.detail || categoryRes.statusText))
        showAlert("error", "Failed", "Could not add job category.")
        return
      }

      // Step 2: Update the form configuration with new category
      if (!formConfig) {
        console.error("Form configuration not available")
        showAlert("error", "Failed", "Form configuration not available.")
        return
      }

      const updatedCategories: string[] = [
        ...(formConfig.fields?.category?.options || []),
        trimmedCategory
      ]

      const formUpdatePayload: JobApplicationFormConfig = {
        ...formConfig,
        fields: {
          ...formConfig.fields,
          category: {
            ...(formConfig.fields?.category || {}),
            options: updatedCategories
          }
        }
      }

      // Step 3: Update the form configuration with new category
      console.log("Sending form update payload for category:", JSON.stringify(formUpdatePayload, null, 2))
      const formRes: Response = await fetch(
        buildApiUrl('/customize/admin/customize-job-application-form?widget_id=Model'),
        {
          method: "PUT",
          headers: {
            "accept": "application/json",
            "Content-Type": "application/json"
          },
          body: JSON.stringify(formUpdatePayload),
        }
      )

      if (!formRes.ok) {
        const formErrorData: ErrorResponse = await formRes.json().catch(() => ({}))
        console.error("Failed to update form configuration: " + (formErrorData.detail || formRes.statusText))
        showAlert("error", "Failed", "Category added but form configuration update failed.")
        return
      }

      const formResponseData: ApiResponse = await formRes.json()
      console.info(`Job category "${trimmedCategory}" added and form updated successfully!`, formResponseData.message)

      resetCategory()
      setCategoryValue("jobCategory", "")
      await fetchFormConfig() // Refresh form configuration and database data
      showAlert("success", "Added", `Job category "${trimmedCategory}" added.`)
    } catch (error: unknown) {
      console.error("Failed to add job category", error)
      showAlert("error", "Failed", "Could not add job category.")
    }
  }

  // Enhanced experience validation with real-world levels
  const onAddExperience = async (data: { experience: string }) => {
    try {
      if (!data.experience.trim()) {
        console.warn("Experience level cannot be blank")
        showAlert("error", "Validation", "Experience level cannot be blank.")
        return
      }
      if (!isValidExperienceForAdd(data.experience.trim())) {
        console.warn("Invalid experience level. Must be 1–50 years or a level name.")
        showAlert("error", "Validation", "Invalid experience. Enter 1–50 years or a level name (e.g., Entry, Senior).")
        return
      }

      const trimmedExperience = data.experience.trim()
      const candidateName = /^\d+$/.test(trimmedExperience)
        ? trimmedExperience
        : normalizeExperienceName(trimmedExperience)
      const existingExperience = experienceLevels.find((exp) => exp.name.toLowerCase() === candidateName.toLowerCase())
      if (existingExperience) {
        console.warn(`Experience level "${candidateName}" already exists!`)
        showAlert("error", "Duplicate", `Experience level "${candidateName}" already exists.`)
        return
      }

      // Step 1: Add experience to the jobs/experiences endpoint
      const res = await fetch(buildApiUrl(API_CONFIG.ENDPOINTS.JOBS_EXPERIENCES), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: candidateName }),
      })

      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}))
        console.error("Failed to add experience level: " + (errorData.detail || res.statusText))
        showAlert("error", "Failed", "Could not add experience level.")
        return
      }

      // Step 2: Update the form configuration with new experience
      if (!formConfig) {
        console.error("Form configuration not available")
        showAlert("error", "Failed", "Form configuration not available.")
        return
      }

      const updatedExperiences: string[] = [
        ...(formConfig.fields?.experience?.options || []),
        candidateName
      ]

      const formUpdatePayload: JobApplicationFormConfig = {
        ...formConfig,
        fields: {
          ...formConfig.fields,
          experience: {
            ...(formConfig.fields?.experience || {}),
            options: updatedExperiences
          }
        }
      }

      // Step 3: Update the form configuration with new experience
      console.log("Sending form update payload for experience:", JSON.stringify(formUpdatePayload, null, 2))
      const formRes = await fetch(buildApiUrl('/customize/admin/customize-job-application-form?widget_id=Model'), {
        method: "PUT",
        headers: {
          "accept": "application/json",
          "Content-Type": "application/json"
        },
        body: JSON.stringify(formUpdatePayload),
      })

      if (!formRes.ok) {
        const formErrorData = await formRes.json().catch(() => ({}))
        console.error("Failed to update form configuration: " + (formErrorData.detail || formRes.statusText))
        showAlert("error", "Failed", "Experience added but form configuration update failed.")
        return
      }

      const formResponseData = await formRes.json()
      console.info(`Experience level "${candidateName}" added and form updated successfully!`, formResponseData.message)

      resetExperience()
      setExperienceValue("experience", "")
      await fetchFormConfig() // Refresh form configuration and database data
      showAlert("success", "Added", `Experience level "${candidateName}" added.`)

    } catch (error) {
      console.error("Failed to add experience level:", error)
      showAlert("error", "Failed", `Could not add experience level: ${error instanceof Error ? error.message : 'Unknown error'}`)
    }
  }

  const handleDeleteCategory = async (id: string): Promise<void> => {
    try {
      // Step 1: Find the category name to remove from options
      const categoryToDelete: OptionItem | undefined = jobCategories.find((cat: OptionItem) => cat.id === id)
      const categoryNameToRemove: string = categoryToDelete?.name || ""

      if (!categoryNameToRemove) {
        console.warn(`Could not find category with id ${id} in local data`)
        showAlert("error", "Failed", "Category not found.")
        return
      }

      // Step 2: Delete category from the database
      const deleteRes: Response = await fetch(buildApiUrl(`${API_CONFIG.ENDPOINTS.JOBS_CATEGORIES}/${id}`), {
        method: "DELETE",
      })

      if (!deleteRes.ok) {
        const deleteErrorData: ErrorResponse = await deleteRes.json().catch(() => ({}))
        console.error("Failed to delete job category: " + (deleteErrorData.detail || deleteRes.statusText))
        showAlert("error", "Failed", "Could not delete job category.")
        return
      }

      // Step 3: Update the form configuration with removed category
      if (!formConfig) {
        console.error("Form configuration not available")
        showAlert("error", "Failed", "Form configuration not available.")
        return
      }

      const currentFields = formConfig.fields || {}
      const currentCategory = (currentFields as JobApplicationFormConfig['fields']).category || {
        label: 'Category',
        required: false,
        options: []
      } as SelectFieldConfig

      const updatedCategories: string[] = (currentCategory.options || []).filter(
        (option: string) => option !== categoryNameToRemove,
      )

      const formUpdatePayload: JobApplicationFormConfig = {
        ...formConfig,
        fields: {
          ...currentFields,
          category: {
            ...currentCategory,
            options: updatedCategories,
          },
        },
      }

      // Step 4: Update the form configuration with removed category
      console.log("Sending form update payload for category removal:", JSON.stringify(formUpdatePayload, null, 2))
      let formRes: Response = await fetch(
        buildApiUrl('/customize/admin/customize-job-application-form?widget_id=Model'),
        {
          method: "PUT",
          headers: {
            "accept": "application/json",
            "Content-Type": "application/json"
          },
          body: JSON.stringify(formUpdatePayload),
        }
      )

      // Retry with POST if server rejects PUT (some backends use POST for upsert)
      if (!formRes.ok && formRes.status === 405) {
        try {
          formRes = await fetch(
            buildApiUrl('/customize/admin/customize-job-application-form?widget_id=Model'),
            {
              method: "POST",
              headers: {
                "accept": "application/json",
                "Content-Type": "application/json"
              },
              body: JSON.stringify(formUpdatePayload),
            },
          )
        } catch { }
      }

      if (!formRes.ok) {
        const formErrorData: ErrorResponse = await formRes.json().catch(() => ({}))
        console.error("Failed to update form configuration: " + (formErrorData.detail || formRes.statusText))
        showAlert("error", "Failed", "Category deleted but form configuration update failed.")
        return
      }

      const formResponseData: ApiResponse = await formRes.json()
      console.info("Job category deleted and form updated successfully!", formResponseData.message)

      await fetchFormConfig() // Refresh form configuration and database data
      showAlert("success", "Deleted", "Job category removed.")
    } catch (error: unknown) {
      console.error("Failed to delete job category", error)
      showAlert("error", "Failed", "Could not delete job category.")
    }
  }

